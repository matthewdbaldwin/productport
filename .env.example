# ProductPort — environment

# ── Database (Prisma 7 + adapter-pg) ─────────────────────────────────────────
DATABASE_URL=postgresql://productport:productport@localhost:5432/productport
# Optional split for migrations under a higher-priv role (B2). Falls back to DATABASE_URL.
# MIGRATE_DATABASE_URL=

# ── SSO (SalesPort is the hub; this app is a spoke) ──────────────────────────
SALESPORT_JWT_ISSUER=https://salesport.local
SALESPORT_JWT_PUBLIC_KEY=          # base64 of the RS256 public PEM
SALESPORT_JWT_PUBLIC_KEY_B=        # optional 2nd verify key (HubPort Slice 1) — empty until Slice 3
JWT_SECRET=                        # local-login HS256 secret (optional)
COOKIE_DOMAIN=
# SsoClaims contract check on the verify path. enforce | warn | off.
# Break-glass to 'warn' reverts to non-blocking without a redeploy.
SSO_CLAIMS_MODE=enforce

# ── Outbound cross-app (canonical WEBHOOK_SECRET_<FROM>_<TO>, UPPERCASE app names) ─
# Bug reports are signed with this and forwarded to SalesPort's central queue.
# Set the matching value on SalesPort's receiver. reference_webhook_topology.
WEBHOOK_SECRET_PRODUCTPORT_SALESPORT=
SALESPORT_API_URL=http://localhost:4000

# ── Inbound SSO lifecycle (SalesPort → this app, POST /api/sso/lifecycle) ────
# HMAC secret the createLifecycleGuard receiver verifies (header x-salesport-signature).
# Holds the same value SalesPort sets as PRODUCTPORT_LIFECYCLE_SECRET on its side.
# Guard fails CLOSED (503) if unset, unless ALLOW_UNSIGNED_LIFECYCLE=true (dev only).
SALESPORT_LIFECYCLE_SECRET=
# ALLOW_UNSIGNED_LIFECYCLE=true

# ── Misc ─────────────────────────────────────────────────────────────────────
PORT=4100
WEB_ORIGIN=http://localhost:3100
NODE_ENV=development
# EMAIL_DISABLED=true   # dev safety; prod task role also omits ses:SendEmail unless this app emails
