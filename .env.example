# ProductPort — environment

# ── Database (Prisma 7 + adapter-pg) ─────────────────────────────────────────
DATABASE_URL=postgresql://productport:productport@localhost:5432/productport
# Optional split for migrations under a higher-priv role (B2). Falls back to DATABASE_URL.
# MIGRATE_DATABASE_URL=

# ── SSO (SalesPort is the hub; this app is a spoke) ──────────────────────────
SALESPORT_JWT_ISSUER=https://salesport.local
SALESPORT_JWT_PUBLIC_KEY=          # base64 of the RS256 public PEM
SALESPORT_JWT_PUBLIC_KEY_B=        # optional 2nd verify key (HubPort Slice 1) — empty until Slice 3
JWT_SECRET=                        # local-login HS256 secret (optional)
COOKIE_DOMAIN=
# SsoClaims contract check on the verify path. enforce | warn | off.
# Break-glass to 'warn' reverts to non-blocking without a redeploy.
SSO_CLAIMS_MODE=enforce
# IdP address for /sso/exchange + the refresh/revoke calls (SSO slice 5a,
# 2026-08-31). REQUIRED — the module throws at load without it. The old
# SALESPORT_API_URL fallback was retired; SalesPort's IdP endpoints no
# longer exist.
# Dev default points at the DEV hub. Prod is supplied by the ECS task definition.
# NEVER default this to the prod hub here: a dev copying .env.example verbatim would
# have local refresh/revoke calls hit PRODUCTION HubPort and revoke real sessions.
IDP_API_URL=https://hub-dev.microport.com
# ── Refresh-token rotation (opt-in; inert until enabled) ─────────────────────
# Flips /sso/exchange to send X-Satellite-Refresh: 1 so the IdP mints an
# (access, refresh) cookie pair instead of the legacy single 8h token, and
# arms the near-expiry peek middleware that silently rotates it. Both this
# flag and the secret below default off/unset — code ships fully inert.
# docs/superpowers/{specs,plans}/2026-08-14-productport-refresh-client*.
PRODUCTPORT_REFRESH_ENABLED=false
# Shared secret the IdP's /api/auth/refresh + /refresh/revoke check
# (X-Satellite-Token). Falls back to SALESPORT_REFRESH_SHARED_SECRET if unset,
# so an environment carrying the legacy salesport-named secret needs no new
# value, just to leave this one unset. (IDP_API_URL above lost its own
# SALESPORT_* fallback in SSO slice 5a and is now required — this secret's
# fallback is unaffected.) Set IDP_REFRESH_SHARED_SECRET explicitly at the
# Slice-4h IdP flip to HubPort.
IDP_REFRESH_SHARED_SECRET=

# ── Outbound cross-app (canonical WEBHOOK_SECRET_<FROM>_<TO>, UPPERCASE app names) ─
# Bug reports are signed with this and forwarded to SalesPort's central queue.
# Set the matching value on SalesPort's receiver. reference_webhook_topology.
WEBHOOK_SECRET_PRODUCTPORT_SALESPORT=
SALESPORT_API_URL=http://localhost:4000

# ── Inbound SSO lifecycle (SalesPort → this app, POST /api/sso/lifecycle) ────
# HMAC secret the createLifecycleGuard receiver verifies (header x-salesport-signature).
# Holds the same value SalesPort sets as PRODUCTPORT_LIFECYCLE_SECRET on its side.
# Guard fails CLOSED (503) if unset, unless ALLOW_UNSIGNED_LIFECYCLE=true (dev only).
SALESPORT_LIFECYCLE_SECRET=

# HubPort fleet conformance sweep (hubport#84) — HMAC secret for HubPort's
# POST /api/internal/digest-grants pull (dedicated — NOT the census or
# lifecycle secret). Must match what HubPort signs with. Hand-issued
# credential: provisioned in the ECS task def before Task 8's scheduler runs
# live, same allowance hubport#84 grants for hubport#83.
HUBPORT_DIGEST_SECRET=
# ALLOW_UNSIGNED_LIFECYCLE=true

# ── Inbound OpsPort read (OpsPort → this app, GET /api/opsport/*) ─────────────
# Static bearer key (timingSafeEqual-checked) OpsPort sends for catalog search +
# live clearance reads (HubPort forum #22, D6). Must match PRODUCTPORT_API_KEY
# in OpsPort's .env (same value, same name).
OPSPORT_API_KEY=

# ── Inbound ReviewPort read (ReviewPort → this app, GET /api/reviewport/*) ────
# Static bearer key (same guard as OpsPort's, its own value so either consumer
# can be revoked alone) ReviewPort sends for its "Add from ProductPort" picker:
# product search + detail (ReviewPort#58). Must match PRODUCTPORT_API_KEY in
# ReviewPort's .env. Read-only; nothing is written through this seam.
REVIEWPORT_API_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
PORT=4100
WEB_ORIGIN=http://localhost:3100
NODE_ENV=development
# EMAIL_DISABLED=true   # dev safety; prod task role also omits ses:SendEmail unless this app emails
