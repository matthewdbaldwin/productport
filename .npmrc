@matthewdbaldwin:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
always-auth=true
# Refuse `npm install`/`npm ci` under an npm major other than package.json engines.npm.
# npm 11 writes lockfiles CI's npm 10 rejects (EUSAGE Missing @swc/helpers). See scripts/check-lockfile.sh.
engine-strict=true
