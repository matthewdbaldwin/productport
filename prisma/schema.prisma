// ProductPort schema. Prisma 7 + driver adapter (adapter-pg).
//
// FK-table naming: this template emits @@map("User"). Pick "users"
// (snake-plural, like sp/op) or "User" (default, like rp/cp/ep) at mint time —
// all hand-written SQL must match. feedback_prisma_migration_fk_table_naming_per_repo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Prisma 7.8 removed `url` from the schema — the connection URL lives in
  // prisma.config.mjs (Migrate) + the PrismaPg adapter (runtime). See
  // feedback_prisma_config_mjs_not_ts.
  provider = "postgresql"
}

// Role model (PRD §5). Every authenticated employee is a `viewer` by default
// (read-only browse); editing is role-gated. Mirror these values in
// microport-contracts ROLE_CONTRACTS.productport (Phase 4) — the SSO role map
// must agree or hires 403 / unknown_role at login.
enum Role {
  viewer
  product        // edit descriptive fields + trials + images
  product_admin  // + regulatory-clearance matrix, taxonomy, lifecycle
  superuser
}

model User {
  id          Int       @id @default(autoincrement())
  email       String    @unique
  name        String?
  role        Role      @default(viewer)
  active      Boolean   @default(true)
  locale      String?   @default("en-US")
  password    String?   // null for SSO-only users
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessions    Session[]
  audits      ProductAudit[]

  @@map("User")
}

// ── Catalog (ProductPort-owned master) ─────────────────────────────────────
// PRD §4 object model. ProductPort is the system of record for product
// descriptive + regulatory-clearance + clinical-evidence data. MDMcode is the
// (later) mesh join key, minted by SalesPort — nullable until the P2 mapping.

enum ProductStatus {
  ACTIVE
  DISCONTINUED
  DRAFT
}

// Strategic product tier (single per product; null = untiered). Rendered as a
// gold/silver/bronze badge — see src/lib/tierPalette.js.
enum ProductTier {
  TIER1
  TIER2
  TIER3
}

// Business classification from the GloMatrix brochure (Core / Hi-po / Flagship).
// Separate from `tier`; manually assigned (the brochure defines but never tags
// these per-product). See src/lib/classification.js.
enum ProductClassification {
  CORE
  HIPO
  FLAGSHIP
}

enum ClearanceStatus {
  APPROVED       // "cleared"
  IN_PROGRESS    // "in progress"
  SUBMITTED      // "submitted"
  NOT_APPROVED   // "not cleared"
  NONE           // no status on file
}

model Product {
  id               String        @id @default(cuid())
  // The original catalog key from the standalone tool (e.g. "accusniper").
  // Stable, human-readable, used in URLs + the seed image filename.
  slug             String        @unique
  name             String
  subsidiary       String
  therapeuticArea  String
  category         String?
  type             String?
  tagline          String?
  overview         String?       @db.Text
  features         String?       @db.Text  // pipe-delimited list (legacy format)
  indication       String?       @db.Text
  patientPopulation String?      @db.Text
  specs            String?       @db.Text  // pipe-delimited "key: value" list
  regNotes         String?       @db.Text
  image            String?                 // primary image filename (served from web/public/products)
  mdmCode          String?       @unique    // mesh join key (P2) — minted by SalesPort
  status           ProductStatus @default(ACTIVE)
  tier             ProductTier?              // strategic tier (gold/silver/bronze badge); null = untiered
  classification   ProductClassification?    // Core/Hi-po/Flagship (brochure); manual, separate from tier
  businessSegment  String?                   // 12-way GloMatrix taxonomy above therapeuticArea
  applicableDepartments String? @db.Text     // pipe-delimited (e.g. "Cardiology|ICU|Thoracic Surgery")
  modelNumbers     String?       @db.Text     // pipe-delimited SKU/model list (first-class; was buried in specs)
  developmentStatus String?                   // lifecycle free-text ("Under Development — est. cert Feb 2026"); null = marketed
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?

  clearances       RegulatoryClearance[]
  trials           Trial[]
  audits           ProductAudit[]

  @@index([therapeuticArea])
  @@index([subsidiary])
  @@index([category])
  @@index([status])
  @@index([tier])
  @@index([classification])
  @@index([businessSegment])
  @@map("products")
}

// Per-product, per-region clearance row (PRD §4). Modelled as rows (not four
// boolean columns) so a 5th regulatory body is one INSERT, not a migration —
// `region` is a free string validated in app code against the known set.
model RegulatoryClearance {
  id         String          @id @default(cuid())
  productId  String
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  region     String          // FDA | CE | NMPA | PMDA | …
  status     ClearanceStatus @default(NONE)
  notes      String?
  updatedAt  DateTime        @updatedAt

  @@unique([productId, region])
  @@index([region, status])
  @@map("regulatory_clearances")
}

model Trial {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  trial        String
  identifier   String?
  n            String?  // free-text in the seed ("1,114", "N/A", ranges)
  design       String?
  result       String?  @db.Text
  displayOrder Int      @default(0)

  @@index([productId])
  @@map("trials")
}

// Append-only edit log — net-new vs the single-user SQLite tool, required for a
// multi-user authoritative master (PRD §4).
model ProductAudit {
  id         String   @id @default(cuid())
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId     Int?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail  String
  action     String   // created | updated | deleted | clearance.updated | trial.added | …
  field      String?
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
  @@map("product_audits")
}

// Server-side session for jti-bearing tokens (B1 Phase 4b) — revocation + UI.
model Session {
  id         String    @id @default(cuid())
  jti        String    @unique
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  revokedAt  DateTime?
  expiresAt  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("sessions")
}

// Durable outbox for any outbound webhook from this platform (at-least-once).
model WebhookOutbox {
  id            String    @id @default(cuid())
  channel       String    // e.g. "productport->salesport"
  eventType     String
  payload       Json
  correlationId String
  attempts      Int       @default(0)
  deliveredAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([deliveredAt])
  @@map("webhook_outbox")
}
